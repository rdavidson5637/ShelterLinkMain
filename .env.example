# =============================================================================
# ShelterLink — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit your .env file to source control.
# =============================================================================

# Server
PORT=3000
NODE_ENV=development   # Change to 'production' when deployed

# App URL — used to build password reset links in emails.
# In production set this to your real domain, e.g. https://shelterlink.yourdomain.com
APP_URL=http://localhost:3000

# Database
DB_HOST=localhost
DB_PORT=8889           # MAMP default; standard MySQL is 3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=ShelterLink

# Sessions — CHANGE THIS to a long random string in production
SESSION_SECRET=change_me_to_something_long_and_random_in_production

# Feedback link signing — optional separate secret for post-shift feedback
# tokens. Falls back to SESSION_SECRET when blank.
FEEDBACK_TOKEN_SECRET=

# Admin registration key — required to create admin accounts
# Set a strong secret and share it only with staff who need admin access
ADMIN_REGISTRATION_KEY=change_me_before_deployment

# Email (SMTP) — leave blank to disable email sending
# Recommended: use a transactional email service (Brevo, Mailgun, SendGrid, etc.)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=

# Optional: directory for volunteer document uploads (outside web root)
# Default: ./storage/uploads
UPLOAD_DIR=

# GDPR / data retention — anonymise volunteers inactive for this many years
DATA_RETENTION_YEARS=3
