# =============================================================================
# ShelterLink — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit your .env file to source control.
# =============================================================================

# Server
PORT=3000
NODE_ENV=development   # Change to 'production' when deployed

# App URL — used to build password reset links in emails, and in production
# it is the only origin allowed to make credentialed cross-origin requests.
# In production set this to your real domain, e.g. https://shelterlink.yourdomain.com
# Required in production: the app refuses to start without it.
APP_URL=http://localhost:3000

# Optional: extra allowed origins, comma separated. Overrides APP_URL for CORS
# when set. Only needed if something outside this app calls the API.
CORS_ORIGINS=

# Database
# Prefer DATABASE_URL. Use the Supabase SESSION pooler (port 5432), not the
# transaction pooler (6543) — session mode is required for connect-pg-simple
# and for the adapter's prepared-style queries. sslmode is applied in code
# when the host is not localhost.
#
# Format:
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Required in production: the app refuses to start when this is blank.
DATABASE_URL=

# Local Postgres fallback when DATABASE_URL is blank
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=shelterlink
DB_CONNECTION_LIMIT=10
DB_IDLE_TIMEOUT_MS=30000

# Sessions — CHANGE THIS to a long random string in production
# Required in production: the app refuses to start on this placeholder value.
SESSION_SECRET=change_me_to_something_long_and_random_in_production

# Feedback link signing — optional separate secret for post-shift feedback
# tokens. Falls back to SESSION_SECRET when blank.
FEEDBACK_TOKEN_SECRET=

# Admin registration key — required to create admin accounts
# Set a strong secret and share it only with staff who need admin access
# Required in production: the app refuses to start without it.
ADMIN_REGISTRATION_KEY=change_me_before_deployment

# HTTP POST /api/auth/register-admin is always 404 in production.
# Outside production it is still 404 unless this is exactly "true".
# Prefer: npm run create-admin
ALLOW_ADMIN_REGISTRATION=false

# Email (SMTP) — leave blank to disable email sending
# Recommended: use a transactional email service (Brevo, Mailgun, SendGrid, etc.)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=


# Shelter emergency phone — shown to active foster carers
SHELTER_EMERGENCY_PHONE=

# IANA timezone the shelter is in. Day sheets and scheduled jobs use this zone.
# If it is blank in production, jobs use Europe/London.
SHELTER_TIMEZONE=Europe/London

# Web Push (VAPID) — leave blank to disable push notifications gracefully
# Generate with: npx web-push generate-vapid-keys
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:shelterlink@assisi.org.uk

# GDPR / data retention. Leave blank until Assisi sets a period.
# A number here anonymises inactive volunteer accounts after that many years.
# DATA_RETENTION_YEARS=

# Encrypted backups. At least 16 characters. npm run backup refuses to run without it.
# Keep a copy of this key off the server. See docs/runbooks/backup-and-restore.md.
BACKUP_ENCRYPTION_KEY=

# Directory for scripts/backup-db.sh. Keep it off the database disk.
BACKUP_DIR=

# Set to off to skip the Have I Been Pwned password check. Leave unset in production.
PWNED_PASSWORD_CHECK=

# Rate limits. Counts are per 15 minutes unless RATE_LIMIT_WINDOW_MS is set.
# RATE_LIMIT_PUSH_TEST is per hour. Leave blank to use the defaults.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_LOGIN=15
RATE_LIMIT_LOGIN_ACCOUNT=5
RATE_LIMIT_API=300
RATE_LIMIT_REGISTER=8
RATE_LIMIT_FORGOT=5
RATE_LIMIT_FORGOT_ACCOUNT=5
RATE_LIMIT_RESET=8
RATE_LIMIT_MESSAGE=10
RATE_LIMIT_GROUP_BOOKING=8
RATE_LIMIT_PUSH_TEST=3

# Staff address for application and background-check emails. Falls back to EMAIL_USER.
ADMIN_EMAIL=

# Optional aliases for the WEB_PUSH_VAPID_* variables above.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Login-page demo hints. Ignored in production. Leave blank to show no demo accounts.
# Local values are the seeded users documented in database/seed.pg.sql.
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
DEMO_VOLUNTEER_EMAIL=
DEMO_VOLUNTEER_PASSWORD=

# Smoke test (scripts/smoke-test.js). Required to run the script. Never point it at production.
SMOKE_BASE_URL=http://localhost:3000
SMOKE_ADMIN_EMAIL=admin@shelterlink.org
SMOKE_ADMIN_PASSWORD=

# Set to yes before scripts/migrate.js will apply database/034_*.pg.sql.
BACKUP_CONFIRMED=

# Set to yes before create-shelter.js or create-admin.js writes to a Supabase database.
CONFIRM_LIVE_SHELTER=

# Used only by npm run create-admin. Not read by the running server.
# ADMIN_INITIAL_PASSWORD=

# Test-only. scripts and the tenant isolation test refuse any host that is not localhost.
TENANT_DATABASE_URL=
PG_BIN=

# Set by Render, Railway, or the host. Used only to version the service worker. Do not invent these.
RENDER_GIT_COMMIT=
RAILWAY_GIT_COMMIT_SHA=
SOURCE_VERSION=
GIT_COMMIT=
