{
  "name": "shelterlink-backend",
  "version": "0.1.0",
  "description": "ShelterLink Backend API - Animal shelter volunteer management system",
  "private": true,
  "license": "MIT",
  "type": "commonjs",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:setup": "node scripts/setup-db.js --no-seed",
    "db:reset": "node scripts/setup-db.js --seed",
    "create-admin": "node create-admin.js",
    "test": "node --test --test-concurrency=1 \"test/*.test.js\"",
    "migrate": "node scripts/migrate.js",
    "smoke": "node scripts/smoke-test.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-mysql-session": "^3.0.3",
    "express-rate-limit": "^8.3.2",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0",
    "json2csv": "^6.0.0-alpha.2",
    "multer": "^2.2.0",
    "mysql2": "^3.15.3",
    "nodemailer": "^9.0.5",
    "validator": "^13.15.26",
    "xss": "^1.0.15"
  },
  "devDependencies": {
    "nodemon": "^3.1.10"
  }
}
